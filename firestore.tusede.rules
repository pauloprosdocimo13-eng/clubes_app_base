rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function emailAuth() {
      return request.auth.token.email.lower();
    }

    function emailMigracionId() {
      return emailAuth().replace('@', '%40');
    }

    function existeUsuarioTuSede() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        );
    }

    function usuarioTuSede() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function usuarioActivo() {
      return existeUsuarioTuSede()
        && usuarioTuSede().activo == true;
    }

    function esSuperAdmin() {
      return usuarioActivo()
        && usuarioTuSede().rol == 'superadmin';
    }

    function puedeAccederClub(clubId) {
      return usuarioActivo()
        && (
          esSuperAdmin()
          || clubId in usuarioTuSede().clubIds
        );
    }

    function administraClub(clubId) {
      return puedeAccederClub(clubId) && usuarioTuSede().rol in ['superadmin','admin','admin_club'];
    }
    function permiso(clubId, opciones) {
      let ruta = /databases/$(database)/documents/clubes/$(clubId)/configuracion/permisos_roles;
      return usuarioTuSede().rol in ['tesoreria','administracion','deportes','institucional','ingreso']
        && exists(ruta) && get(ruta).data.get(usuarioTuSede().rol, []).hasAny(opciones);
    }
    function accesoColeccion(clubId, col, lectura) {
      return (col in ['socios','auditoria_socios'] && (permiso(clubId,['Padrón Socios','Caja y Finanzas']) || (lectura && permiso(clubId,['Escanear Ingreso','Tomar Asistencia']))))
        || (col in ['movimientos','movimientos_eliminados','pagos','vencimientos'] && permiso(clubId,['Caja y Finanzas']))
        || (col == 'asistencias' && permiso(clubId,['Tomar Asistencia','Escanear Ingreso']))
        || (col == 'jugadores' && permiso(clubId,['Gestionar Plantel']))
        || (col in ['partidos','historial_partidos'] && permiso(clubId,['Gestionar Partidos','Consola en VIVO']))
        || (col == 'partidos_en_vivo' && permiso(clubId,['Consola en VIVO']))
        || (col == 'rivales' && permiso(clubId,['Rivales y Ubicaciones']))
        || (col == 'avisos' && permiso(clubId,['Avisos Urgentes']))
        || (col == 'noticias' && permiso(clubId,['Publicar Noticia']))
        || (col == 'galeria' && permiso(clubId,['Subir Fotos']))
        || (col == 'publicidad' && permiso(clubId,['Publicidad']))
        || (col == 'espacios' && (permiso(clubId,['Configurar Espacios']) || (lectura && permiso(clubId,['Agenda / Reservas']))))
        || (col == 'reservas' && permiso(clubId,['Agenda / Reservas']))
        || (col == 'productos' && permiso(clubId,['Tienda Oficial']))
        || (col == 'sorteos' && permiso(clubId,['Gestionar Rifas']))
        || (col == 'actividades' && permiso(clubId,['Configuración Club']));
    }
    function accesoConfiguracion(clubId, doc, lectura) {
      return (lectura && doc in ['permisos_roles','general','actividades','contacto'])
        || (doc == 'general' && permiso(clubId,['Configurar Tiras','Configuración Club']))
        || (doc in ['actividades','contacto'] && permiso(clubId,['Configuración Club']))
        || (doc == 'precios' && (permiso(clubId,['Config. Precios']) || (lectura && permiso(clubId,['Padrón Socios','Caja y Finanzas','Tomar Asistencia']))))
        || (doc == 'pagos' && permiso(clubId,['Configurar Pagos']))
        || (doc == 'categorias_finanzas' && permiso(clubId,['Caja y Finanzas']))
        || (doc == 'seguridad' && lectura && permiso(clubId,['Escanear Ingreso']))
        || (doc == 'reservas' && permiso(clubId,['Agenda / Reservas','Configurar Espacios']))
        || (doc == 'aviso_entrada' && permiso(clubId,['Configurar Pop-up']));
    }

    function existeMigracionPropia(clubId) {
      return estaAutenticado()
        && request.auth.token.email != null
        && exists(
          /databases/$(database)/documents/migraciones_admin/$(clubId)/usuarios/$(emailMigracionId())
        );
    }

    function migracionPropia(clubId) {
      return get(
        /databases/$(database)/documents/migraciones_admin/$(clubId)/usuarios/$(emailMigracionId())
      ).data;
    }

    function migracionValida(clubId) {
      return existeMigracionPropia(clubId)
        && migracionPropia(clubId).email == emailAuth()
        && migracionPropia(clubId).clubId == clubId
        && migracionPropia(clubId).autorizado == true
        && migracionPropia(clubId).estado == 'preparado'
        && !exists(/databases/$(database)/documents/eliminaciones_club/$(clubId));
    }

    match /roles/{rolId} {
      allow read: if usuarioActivo();
      allow create, update, delete: if false;
    }

    match /usuarios/{userId} {
      allow get: if estaAutenticado()
        && (
          request.auth.uid == userId
          || esSuperAdmin()
        );

      allow list: if esSuperAdmin();

      allow create: if estaAutenticado()
        && request.auth.uid == userId
        && request.auth.token.email != null
        && request.resource.data.keys().hasOnly([
          'nombre',
          'email',
          'rol',
          'clubPrincipal',
          'clubIds',
          'activo'
        ])
        && request.resource.data.email == emailAuth()
        && request.resource.data.activo == true
        && request.resource.data.clubPrincipal is string
        && migracionValida(request.resource.data.clubPrincipal)
        && request.resource.data.rol
          == migracionPropia(request.resource.data.clubPrincipal).rolTuSede
        && request.resource.data.nombre
          == migracionPropia(request.resource.data.clubPrincipal).nombre
        && request.resource.data.clubIds is list
        && request.resource.data.clubIds.size() == 1
        && request.resource.data.clubIds[0]
          == request.resource.data.clubPrincipal
        && exists(
          /databases/$(database)/documents/roles/$(request.resource.data.rol)
        )
        && get(
          /databases/$(database)/documents/roles/$(request.resource.data.rol)
        ).data.activo == true
        && get(
          /databases/$(database)/documents/roles/$(request.resource.data.rol)
        ).data.alcance == 'club';

      allow update, delete: if false;
    }

    match /migraciones_admin/{clubId}/usuarios/{emailId} {
      allow get: if esSuperAdmin()
        || (
          estaAutenticado()
          && request.auth.token.email != null
          && emailId == emailMigracionId()
          && resource.data.email == emailAuth()
          && resource.data.clubId == clubId
        );

      allow list: if esSuperAdmin();
      allow create, update: if esSuperAdmin();
      allow delete: if false;
    }

    match /clubes/{clubId} {
      allow get: if resource.data.activo == true
        || puedeAccederClub(clubId);

      allow list: if esSuperAdmin();
      allow create, update, delete: if false;

      match /{coleccion}/{documento}/{resto=**} {
        allow read: if puedeAccederClub(clubId)
          && !exists(/databases/$(database)/documents/eliminaciones_club/$(clubId))
          && (administraClub(clubId) ||
            (coleccion == 'configuracion' ? accesoConfiguracion(clubId, documento, true) : accesoColeccion(clubId, coleccion, true)));
        allow write: if puedeAccederClub(clubId)
          && !exists(/databases/$(database)/documents/eliminaciones_club/$(clubId))
          && (administraClub(clubId) ||
            (coleccion == 'configuracion' ? accesoConfiguracion(clubId, documento, false) : accesoColeccion(clubId, coleccion, false)));
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
