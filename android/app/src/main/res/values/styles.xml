<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- CAMBIO 1: Usamos Theme.Black para asegurarnos que la base sea oscura -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        
        <!-- Esto llama a tu archivo launch_background.xml (que ya pusimos en negro) -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        
        <!-- CAMBIO 2: IMPORTANTE - Ponemos esto en FALSE para que pinte el fondo negro -->
        <item name="android:windowIsTranslucent">false</item>
        
        <!-- CAMBIO 3: Para Android 12+ (que usa un sistema de splash nuevo), forzamos el negro también -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>

    <!-- Tema normal de la App (cuando ya cargó Flutter) -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>